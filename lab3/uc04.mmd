sequenceDiagram
    actor P as Player
    participant UI as Ігровий інтерфейс
    participant S as Сервіс керування Squad
    participant Squad as Squad
    participant Mob as Mob

    P->>+UI: Розформувати Squad
    UI->>+S: disbandSquad(playerId, squadId)
    S->>+Squad: findSquadById(squadId)
    Squad-->>-S: Squad з operatorId або відсутній
    alt Squad відсутній (SC-12)
        S-->>UI: SQUAD_NOT_FOUND
    else Squad належить Player (SC-10, SC-11)
        S->>+Mob: listSquadMembers(squadId)
        Mob-->>-S: Склад Squad
        opt Склад містить Mob (SC-10)
            loop Для кожного Mob у складі Squad
                S->>+Mob: clearTaskAssignment(mobId)
                Mob-->>-S: Призначення Task знято
                S->>+Mob: clearSquadMembership(mobId)
                Mob-->>-S: Членство знято, власника збережено
            end
        end
        S->>+Squad: deleteSquad(squadId)
        Squad-->>-S: Squad видалено
        S-->>UI: SUCCESS
    end
    deactivate S
    alt Результат SUCCESS (SC-10, SC-11)
        UI->>UI: removeSquadFromList(squadId)
        UI-->>P: Оновлений список Squad
    else Результат SQUAD_NOT_FOUND (SC-12)
        UI-->>P: Помилка «Squad не знайдено»
    end
    deactivate UI
