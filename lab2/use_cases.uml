@startuml
left to right direction
skinparam actorStyle awesome
skinparam shadowing false
skinparam defaultFontName SansSerif

actor "Operator\n(абстрактний)" as Operator
actor Player
actor AIOpponent
Player --|> Operator
AIOpponent --|> Operator

usecase "UC-01\nСтворити Squad" as UC01
usecase "UC-02\nПризначити Squad цілі" as UC02
usecase "UC-03\nДодати Mob до наявного Squad" as UC03
usecase "UC-04\nРозформувати Squad" as UC04
usecase "UC-05\nВилучити Mob зі Squad" as UC05
usecase "UC-06\nПерехопити безпосереднє керування Mob" as UC06

UC06 ..> UC05 : <<include>>

Operator -- UC01
Operator -- UC02
Player -- UC03
Player -- UC04
Player -- UC05
Player -- UC06

@enduml
